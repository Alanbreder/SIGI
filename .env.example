# GEMINI_API_KEY: Configuração do Gemini API
GEMINI_API_KEY=""

# APP_URL: URL onde a aplicação está rodando
APP_URL="http://localhost:3000"

# =========================================================
# CONFIGURAÇÃO DE AMBIENTE SIP (Sistema de Inteligência do Cliente)
# =========================================================
# APP_ENV: Define o ambiente ativo.
# Opções: 'development' (Desenvolvimento/Vibe Coding - Supabase Cloud)
#         'production' (Produção - Supabase Local no Proxmox)
APP_ENV="development"
VITE_APP_ENV="development"

# Supabase Credentials (carregadas dinamicamente sem hardcode)
# Para Desenvolvimento (Supabase Cloud):
# VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsIn..."

# Para Produção (Supabase Local no Proxmox):
# VITE_SUPABASE_URL="http://192.168.x.x:54321" (ou seu domínio interno com Nginx)
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsIn..."

VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
